/* Beautiful Blue Gradient Dark Theme */
html, body {
  background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%) !important;
  color: white !important;
  min-height: 100vh !important;
  margin: 0;
  padding: 0;
}

/* Ensure main container has dark background */
.min-h-screen {
  background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%) !important;
}

/* Override any white backgrounds */
.bg-white {
  background-color: #1e3a8a !important;
}

/* Ensure text is visible */
.text-black {
  color: white !important;
}

/* Beautiful gradient backgrounds */
.bg-gradient-to-br {
  background-image: linear-gradient(to bottom right, var(--tw-gradient-stops)) !important;
}

/* Ensure cards have proper dark styling */
.bg-black\/40 {
  background-color: rgba(0, 0, 0, 0.4) !important;
}

/* Glowing effects */
.shadow-\[0_0_40px_rgba\(251\,191\,36\,0\.5\)\] {
  box-shadow: 0 0 40px rgba(251, 191, 36, 0.5) !important;
}